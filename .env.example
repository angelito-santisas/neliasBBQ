# Spring Boot / Supabase PostgreSQL (server-side only)
SUPABASE_DB_URL=jdbc:postgresql://your-supabase-host:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres.your-project-ref
SUPABASE_DB_PASSWORD=replace-me
DB_POOL_SIZE=5
DB_MIGRATIONS_PATH=../database/migrations
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Optional outbound order webhook
# Supabase Auth: public project URL and publishable key, never a service-role key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-me
# Comma-separated Supabase Auth user UUIDs permitted to manage the restaurant.
STAFF_USER_IDS=

ORDER_WEBHOOK_URL=
ORDER_WEBHOOK_SECRET=
